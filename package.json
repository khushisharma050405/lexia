{
  "name": "lexia",
  "version": "1.0.0",
  "private": true,
  "description": "AI Language Translation and Recognition System",
  "scripts": {
    "start": "./run.sh",
    "dev": "./run.sh",
    "dev:backend": "cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "test:backend": "cd backend && source .venv/bin/activate && pytest -q",
    "test": "npm run test:backend"
  }
}
