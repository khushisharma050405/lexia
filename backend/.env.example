# Copy to .env and edit. Everything is optional: LEXIA translates out of the box.

# Used to sign login tokens. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# If left as-is, a random key is generated and stored in backend/data/.secret.
SECRET_KEY=change-me

# Optional: enables Formal style, plus written Meaning & Context notes.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Comma-separated origins allowed to call the API from a browser (dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hours a login stays valid.
TOKEN_TTL_HOURS=168
